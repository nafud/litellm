# Secrets and per-server state: never commit these (they live under /opt/llm-gateway/<component>/)
*.env
!*.env.example

# Assessment reports contain host details (users, ports, keys paths)
reports/*
!reports/.gitkeep

# Local scratch
*.swp
.DS_Store

# Image archives produced by scripts/fetch-images.sh (multi-GB, transferred by scp)
images/
