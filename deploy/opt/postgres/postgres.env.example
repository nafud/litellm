# Environment of the postgres container: the password only. Database and role names
# are set in llmgw-postgres.container (POSTGRES_DB / POSTGRES_USER).
# Install as /opt/llm-gateway/postgres/postgres.env, owner llmgw, mode 0600.
# Format: KEY=VALUE, one per line, no quotes (podman passes values literally).
# Generate with:  openssl rand -hex 32
# (hex only: the same value is embedded in DATABASE_URL in litellm.env)

POSTGRES_PASSWORD=REPLACE_WITH_openssl_rand_hex_32
