# LiteLLM proxy: the only service with egress.
[Unit]
Description=LLM gateway: LiteLLM proxy
# PostgreSQL is mandatory (allow_requests_on_db_unavailable: false): start after it is
# healthy, and stop/restart together with it.
Requires=llmgw-postgres.service
After=llmgw-postgres.service
# Presidio is wanted, not required: the guardrail fails closed per request if it is down
# (docs/05 §5.5 tests exactly that), so LiteLLM may keep running while Presidio restarts.
Wants=llmgw-presidio-analyzer.service llmgw-presidio-anonymizer.service
After=llmgw-presidio-analyzer.service llmgw-presidio-anonymizer.service

[Container]
ContainerName=litellm
# Non-root variant (uid 65534). Pinned to the linux/amd64 manifest digest (the bytes that
# are loaded on the server); it is listed by the cosign-signed multi-arch index
# sha256:c36f3b27a5a817329e0fcf9c4e3a7bf58b62a5a736ad5352f0a5771c1be58404 (see bin/images.tsv).
Image=ghcr.io/berriai/litellm-non_root:v1.100.1@sha256:833abd09590afee0119dd574212fb01294dcc7d940ad21fabc0bf0681a9f4aea
Pull=never
# Secrets only LiteLLM may see: master key, salt key, DATABASE_URL, UI login, provider keys.
EnvironmentFile=/opt/llm-gateway/litellm/litellm.env
# Presidio endpoints on the internal network; read by the guardrail at startup.
Environment=PRESIDIO_ANALYZER_API_BASE=http://presidio-analyzer:3000
Environment=PRESIDIO_ANONYMIZER_API_BASE=http://presidio-anonymizer:3000
# Models and provider keys come from config.yaml + environment only, never from the DB/UI.
Environment=STORE_MODEL_IN_DB=False
# Runtime UI directory /var/lib/litellm/ui of the non-root image (the image already sets
# this; restated so the unit shows it).
Environment=LITELLM_NON_ROOT=true
# Refuse to start if the schema migration fails (default would log and continue).
Environment=ENFORCE_PRISMA_MIGRATION_CHECK=true
Environment=LITELLM_LOG=INFO
# Remove the interactive API docs from the attack surface.
Environment=NO_DOCS=True
Environment=NO_REDOC=True
Environment=LITELLM_DONT_SHOW_FEEDBACK_BOX=True
# Configuration, read-only, private SELinux label (ignored while SELinux is disabled).
Volume=/opt/llm-gateway/litellm/config.yaml:/app/config.yaml:ro,Z
Tmpfs=/tmp
# Published twice: on the loopback for the admin tunnel (docs/05 §5.8), and on the host
# address for the WAF, which serves litellm.xalqbank.az from here over plain HTTP (D-33,
# docs/08). Host port 8443 because the path between the WAF and this host passes 443,
# 8080 and 8443 only (tested 2026-09-18, docs/08 Results); the container port stays 4000.
# firewalld accepts 8443 from the WAF address 10.50.4.100 only (docs/08 §8.3) and the WAF
# passes the /v1/ inference paths only (docs/08 §8.1). Until docs/08 §8.2 was run the
# second line was absent (loopback only, D-10).
PublishPort=127.0.0.1:4000:4000
PublishPort=10.50.4.68:8443:4000
# Arguments to the image entrypoint (prod_entrypoint.sh -> litellm "$@").
Exec=--config /app/config.yaml --port 4000
Network=llmgw-backend.network
Network=llmgw-egress.network
DropCapability=all
NoNewPrivileges=true
LogDriver=journald
HealthCmd=python3 -c "import urllib.request; urllib.request.urlopen('http://127.0.0.1:4000/health/liveliness', timeout=5)"
HealthInterval=30s
HealthTimeout=10s
HealthRetries=3
HealthStartPeriod=120s
HealthOnFailure=kill
Notify=healthy

[Service]
Restart=always
RestartSec=5
# Prisma migration at first start can exceed the 90 s systemd default.
TimeoutStartSec=300
# Resource budget for LiteLLM: 4 GiB RAM, 2 CPUs (ceilings enforced by cgroup v2 on the
# service's cgroup, which contains the container because Quadlet uses --cgroups=split).
# Was 6 GiB; 2 GiB moved to Open WebUI on 2026-09-17 (D-15 amendment). Measured working
# set of LiteLLM stays well under this ceiling (docs/07 §7.7).
MemoryMax=4G
MemorySwapMax=0
CPUQuota=200%

[Install]
WantedBy=default.target
