# Environment of the openwebui container: secrets only. Everything else is set in
# llmgw-openwebui.container. Install as /opt/llm-gateway/openwebui/openwebui.env,
# owner llmgw, mode 0600 (docs/07 §7.3).
# Format: KEY=VALUE, one per line, no quotes (podman passes values literally).

# Signs the session tokens. Generate with:  openssl rand -hex 32
# Changing it logs every user out; nothing else depends on it.
WEBUI_SECRET_KEY=REPLACE_WITH_openssl_rand_hex_32

# Its own role and database in the existing PostgreSQL container (docs/07 §7.3).
# The password is generated there; hex only, it is embedded in this URL.
DATABASE_URL=postgresql://openwebui:REPLACE_WITH_openssl_rand_hex_32@postgres:5432/openwebui

# LiteLLM virtual key for this front-end (alias 'openwebui', docs/07 §7.4). Never the
# master key: this key decides which models the users see and carries their budget.
OPENAI_API_KEY=sk-REPLACE
