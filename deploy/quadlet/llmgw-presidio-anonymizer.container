# Presidio anonymizer: replaces detected entities with placeholders. Internal network only.
[Unit]
Description=LLM gateway: Presidio anonymizer

[Container]
ContainerName=presidio-anonymizer
Image=ghcr.io/data-privacy-stack/presidio-anonymizer:2.2.364@sha256:e567013893ebc80994e3799f6f55c86aa1f0b0fadb779571ab346f0ec45365c1
Pull=never
Environment=PORT=3000
Environment=WORKERS=1
ReadOnly=true
Network=llmgw-backend.network
DropCapability=all
NoNewPrivileges=true
LogDriver=journald
HealthCmd=curl -fsS http://127.0.0.1:3000/health
HealthInterval=30s
HealthTimeout=5s
HealthRetries=3
HealthStartPeriod=30s
HealthOnFailure=kill
Notify=healthy

[Service]
Restart=always
RestartSec=5
TimeoutStartSec=180

[Install]
WantedBy=default.target
