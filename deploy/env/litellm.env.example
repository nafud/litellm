# Secrets visible ONLY to the litellm container.
# Install as /opt/llm-gateway/env/litellm.env, owner llmgw, mode 0600.
# Format: KEY=VALUE, one per line, no quotes (podman passes values literally).
# Generate keys with:  echo "sk-$(openssl rand -hex 32)"

# Admin key for the proxy API and the admin UI. Never hand this to users; issue virtual keys.
LITELLM_MASTER_KEY=sk-REPLACE

# Encrypts credentials that LiteLLM stores in PostgreSQL.  MUST NOT CHANGE once set:
# rotating it makes anything already encrypted in the DB unreadable. Back it up with the DB.
LITELLM_SALT_KEY=sk-REPLACE

# Same database, user and password as postgres.env; 'postgres' is the container name,
# resolved on the internal network.
DATABASE_URL=postgresql://litellm:REPLACE_WITH_THE_POSTGRES_PASSWORD@postgres:5432/litellm

# Admin UI login at http://127.0.0.1:4000/ui
UI_USERNAME=admin
UI_PASSWORD=REPLACE_WITH_openssl_rand_hex_24

# Provider keys: held by the gateway only. Users never see them.
ANTHROPIC_API_KEY=
# OPENAI_API_KEY=
# GEMINI_API_KEY=
