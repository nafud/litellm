# Compose interpolation + PostgreSQL variables.  Copy to deploy/.env, chmod 600.
# Generate the password with:  openssl rand -hex 32
# (hex only: the value is embedded in DATABASE_URL, so it must be URL-safe)

POSTGRES_DB=litellm
POSTGRES_USER=litellm
POSTGRES_PASSWORD=REPLACE_WITH_openssl_rand_hex_32

# Host address LiteLLM listens on. 127.0.0.1 = local only (safe default for validation).
# Set to the server's internal LAN IP to serve clients, e.g. LITELLM_BIND_ADDR=10.0.20.5
LITELLM_BIND_ADDR=127.0.0.1

# gunicorn workers for the Presidio analyzer (~1 GB RAM each). Raise only if the
# assessment shows RAM headroom and you see analyzer latency under load.
PRESIDIO_ANALYZER_WORKERS=1
